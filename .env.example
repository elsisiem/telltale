# Copy to .env.local. Every variable is optional: without a key, Telltale uses a local fallback.
# An empty value uses the default described in the comment above it.

# Anthropic API key for the live agent. Without it the agent does not run; the gate, scanner and UI still work.
ANTHROPIC_API_KEY=
# Workspace ID (wrkspc_...). Only needed when the key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Model used by the agent. Default: claude-sonnet-5-5.
TELLTALE_MODEL=

# AgentMail key for one real inbox per recipient and inbound leak attribution. Fallback: plus-addressing on the person's email.
AGENTMAIL_API_KEY=
# Kernel key for a hosted browser with live view. Fallback: local Playwright Chromium.
KERNEL_API_KEY=
# Exa key for company lookups on domains missing from the registry. Fallback: registry domains and names only.
EXA_API_KEY=

# Neon Postgres connection string. Fallback: embedded PGlite.
DATABASE_URL=
# Directory for the embedded PGlite database. Default: .telltale/db. Use memory:// for a throwaway database.
TELLTALE_DB_DIR=

# HTTP Basic password for the app (user "telltale"). The overview and tour stay public. Unset: no authentication.
TELLTALE_PASSWORD=
# Base64 of 32 random bytes (openssl rand -base64 32). Encrypts the saved profile. Unset: key file in .telltale/keys.
TELLTALE_VAULT_KEY=
# Base64 of an Ed25519 private key in PEM form. Signs consent receipts. Unset: key file in .telltale/keys.
TELLTALE_RECEIPT_KEY=

# Public URL of a deployment. Pages under /demo/ on this host count as the app's own fictional demo pages.
TELLTALE_PUBLIC_URL=
# Comma-separated hosts of fictional demo sites where submitting a form is safe. Default: bayview-dental.fly.dev.
TELLTALE_DEMO_HOSTS=
# 1 always fills forms without submitting. 0 turns dry run off while no profile is saved. Unset: the synthetic persona is dry run, a saved profile's setting decides.
TELLTALE_DRY_RUN=
# 1 runs the local Chromium without a window. It is always headless on Fly.io.
TELLTALE_HEADLESS=
# "local" forces the local Chromium even when KERNEL_API_KEY is set.
TELLTALE_BROWSER=
