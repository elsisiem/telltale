# Copy to .env.local and fill in. Everything is optional: without a key, Telltale falls back
# to a free local implementation so the app always runs.

# Agent model (required for the live agent; the gate/scanner/UI work without it)
ANTHROPIC_API_KEY=
TELLTALE_MODEL=claude-opus-5-5

# Per-recipient email inboxes (falls back to plus-addressing on your real email)
AGENTMAIL_API_KEY=

# Hosted browsers with live view for the stage demo (falls back to local Playwright)
KERNEL_API_KEY=

# Domain -> company lookups and unregistered-broker discovery (optional)
EXA_API_KEY=

# Postgres (falls back to embedded PGlite under .telltale/db)
DATABASE_URL=
